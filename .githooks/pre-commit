#!/bin/sh
# VHS Studio Pro - Automated Pre-Commit Hook
echo "[Git Hook] Starting automated code validation (Lint & Types)..."

node scripts/lint.mts

if [ $? -ne 0 ]; then
    echo "[Git Hook] ❌ BLOCKED: Commit rejected due to quality gate failures."
    echo "Check logs/build_report.md for details and resolve issues before committing."
    exit 1
fi

echo "[Git Hook] ✅ APPROVED: Codebase is clean. Proceeding with commit..."
exit 0