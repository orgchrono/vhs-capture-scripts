#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
export REPO_ROOT
source "$REPO_ROOT/lib/video-lib.sh"

cmd="${1:-help}"; shift || true
case "$cmd" in
  master)    "$REPO_ROOT/master.sh" "$@" ;;
  preview)   "$REPO_ROOT/stages/1_raw_captures/00_live_preview.sh" "$@" ;;
  capture)   "$REPO_ROOT/stages/1_raw_captures/00_live_capture.sh" "$@" ;;
  cap-prev)  "$REPO_ROOT/stages/1_raw_captures/00_capture_and_preview.sh" "$@" ;;
  trim)      python "$REPO_ROOT/stages/2_restoration/00_trim_black_sync.py" "$@" ;;
  scopes)    "$REPO_ROOT/stages/1_raw_captures/00_live_preview.sh" --scopes "$@" ;;
  hist)      "$REPO_ROOT/stages/2_restoration/preview_hist.sh" "$@" ;;
  denoise)   "$REPO_ROOT/stages/2_restoration/02_denoise_hqdn3d.sh" "$@" ;;
  expcol)    "$REPO_ROOT/stages/2_restoration/01_exposure_colour.sh" "$@" ;;
  chroma)    "$REPO_ROOT/stages/2_restoration/03_chroma_shift.sh" "$@" ;;
  bwdif)     "$REPO_ROOT/stages/3_motion_and_fps_correction/01_deinterlace_bwdif.sh" "$@" ;;
  qtgmc)     "$REPO_ROOT/stages/3_motion_and_fps_correction/00_qtgmc_deint.sh" "$@" ;;
  stab-det)  "$REPO_ROOT/stages/3_motion_and_fps_correction/02_stab_detect.sh" "$@" ;;
  stab-apply)"$REPO_ROOT/stages/3_motion_and_fps_correction/03_stab_apply.sh" "$@" ;;
  conform18) "$REPO_ROOT/stages/3_motion_and_fps_correction/04_conform_18fps.sh" "$@" ;;
  conform24) "$REPO_ROOT/stages/3_motion_and_fps_correction/05_conform_24fps.sh" "$@" ;;
  minterp50) "$REPO_ROOT/stages/3_motion_and_fps_correction/06_minterp_50p.sh" "$@" ;;
  set-sar)   "$REPO_ROOT/stages/4_upscaling/01_set_sar_4x3.sh" "$@" ;;
  up1080)    "$REPO_ROOT/stages/4_upscaling/02_upscale_4x3_to_1080p.sh" "$@" ;;
  fill1080)  "$REPO_ROOT/stages/4_upscaling/03_upscale_fill_1080p.sh" "$@" ;;
  unsharp)   "$REPO_ROOT/stages/4_upscaling/04_unsharp.sh" "$@" ;;
  h264)      "$REPO_ROOT/stages/5_final_encoding/01_encode_h264_crf18.sh" "$@" ;;
  prores)    "$REPO_ROOT/stages/5_final_encoding/02_encode_prores.sh" "$@" ;;
  aoffset)   "$REPO_ROOT/stages/5_final_encoding/03_audio_offset_helper.sh" "$@" ;;
  bmd-setup) "$REPO_ROOT/bin/setup_blackmagic.sh" "$@" ;;
  *)
    echo "Usage: vhs <master|preview|scopes|capture|cap-prev|trim|hist|bmd-setup|denoise|expcol|chroma|bwdif|qtgmc|stab-det|stab-apply|conform18|conform24|minterp50|set-sar|up1080|fill1080|unsharp|h264|prores|aoffset> [args...]"
    exit 2 ;;
esac
