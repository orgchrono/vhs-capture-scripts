# Profile: Blackmagic Design (Intensity Shuttle, Intensity Pro, DeckLink)
# Suporta captura nativa via FFmpeg DeckLink API ou DirectShow no Windows e Linux.

# Dispositivo
DEV_VIDEO="Intensity Shuttle"
ALSA_DEV="DeckLink Audio Capture"

# Sistema de captura: decklink (nativo Blackmagic SDK) ou dshow (DirectShow no Windows)
CAPTURE_SYSTEM=decklink

# Padrão de sinal: OBRIGATÓRIO travar em 'pal' para evitar ciclos de renegociação
# que causam segundos de tela preta a cada jitter da fita.
DECKLINK_FORMAT=pal
DECKLINK_INPUT=composite       # composite ou s_video (recomendado se VCR suportar)
DECKLINK_AUDIO=analog          # analog (RCA)

# Resolução e Cadência nativas PAL
FRAMERATE=25
VIDEO_SIZE=720x576
INPUT_FMT=uyvy422
AUDIO_RATE=48000

# Buffer de entrada para absorver oscilações de barramento e I/O de disco
QUEUE_SIZE=1073741824          # 1GB de ring buffer no SDK DeckLink
BUFFER_SIZE=1024M              # 1GB de buffer DirectShow
