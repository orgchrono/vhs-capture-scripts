# Hauppauge USB-Live2 (example; adjust to your node names)
DEV_VIDEO=/dev/video0
ALSA_DEV=hw:2,0
INPUT_FMT=yuyv422
FRAMERATE=25
VIDEO_SIZE=720x576

# Taxa de amostragem de áudio
# 48000: padrão de broadcast PAL
# 96000: recomendado se o hardware suportar (headroom para sync sem aliasing)
AUDIO_RATE=48000
